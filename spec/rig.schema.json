              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "from": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
