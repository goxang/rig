    },
    "Service": {
      "additionalProperties": true,
      "properties": {
        "build": {
          "allOf": [
            {
              "$ref": "#/definitions/Build"
            }
          ],
          "description": "go: ./cmd/api, dockerfile: path (+ context, args), or command: [...]"
        },
        "delay": {
          "description": "wait this long (10s) after the dependencies are ready before starting the service",
          "type": "string"
        },
        "depends_on": {
          "description": "started first; up deploys in phases and waits for each, leaving dependencies that already run untouched",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "environment for every runtime",
          "type": "object"
        },
        "groups": {
          "description": "names to address several services at once: rig up core",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "health": {
          "allOf": [
            {
              "$ref": "#/definitions/Probe"
            }
          ],
          "description": "{port, path}: readiness for local and docker, a readiness probe in generated manifests"
        },
        "image": {
          "description": "image to run, or the repository name builds push to",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "manual": {
          "description": "started only when named or through a group or section, never by all or its role, so rig infra up skips it too (e.g. frontends, an optional Prometheus)",
          "type": [
            "boolean",
            "string"
          ]
        },
        "metrics": {
          "allOf": [
            {
              "$ref": "#/definitions/Probe"
            }
          ],
          "description": "{port, path}: scraped by the scrape metrics adapter"
        },
        "ports": {
          "additionalProperties": {
            "type": [
              "integer",
              "string"
            ]
          },
          "description": "name: number; svc://service:name resolves names",
          "type": "object"
        },
        "pprof": {
          "allOf": [
            {
              "$ref": "#/definitions/Probe"
            }
          ],
          "description": "{port, path}: where the pprof profiler connects (default: the metrics port)"
        },
        "replicas": {
          "description": "left out: keep the running count (or the manifest's); set (0 included) it wins everywhere",
          "type": [
            "integer",
            "string"
          ]
        },
        "role": {
          "description": "app (default), infra, or load (left out of rig up)",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "run": {
          "allOf": [
            {
              "$ref": "#/definitions/Run"
            }
          ],
          "description": "local runtime: command, args, dir (default: the binary built from build.go)"
        },
        "shared": {
          "description": "infrastructure one environment runs for others: see environments.\u003cname\u003e.infra",
          "type": [
            "boolean",
            "string"
          ]
        }
      },
      "type": "object"
    },
    "Task": {
      "oneOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "$ref": "#/definitions/TaskArg"
              },
              "type": "array"
            },
