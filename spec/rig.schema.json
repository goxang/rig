    "TestSuite": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "bench": {
          "description": "Runs benchmarks matching it (go test -bench); Benchtime and Benchmem tune them.",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "benchmem": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "benchtime": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "command": {
          "description": "Runs the suite through sh instead of go test: pytest, jest, mvn test, cargo test, ... Writing JUnit XML to $RIG_JUNIT gives the screen one row per test; without it the suite passes or fails as a whole by its exit status.",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "count": {
          "type": [
            "integer",
            "string"
          ]
        },
        "cover": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "dir": {
          "description": "Where go test runs (default the project directory).",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Reaches the test binaries; svc:// addresses resolve in the active environment.",
          "type": "object"
        },
        "exclude": {
          "description": "Drops packages from Packages (go list patterns: ./pkg/tests/...), so a suite can be \"everything but the integration tests\".",
          "items": {
            "type": [
