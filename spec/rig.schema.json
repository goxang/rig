            "string",
            "number",
            "boolean"
          ]
        },
        "kind": {
          "description": "Kind: line (default), stat, gauge, bar (one bar per series, its last value), table.",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "legend": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "max": {
          "type": [
            "number",
            "string"
          ]
        },
        "min": {
          "description": "And Max bound a gauge (default 0..100 for %, else 0..the largest value).",
          "type": [
            "number",
            "string"
          ]
        },
        "queries": {
          "description": "Several queries drawn together (p50, p95 and p99), each with its own legend.",
          "items": {
            "$ref": "#/definitions/PanelQuery"
          },
          "type": "array"
        },
        "query": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "row": {
          "description": "Starts a new titled row of panels; a panel with only row: is the row's header.",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "source": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "stack": {
          "description": "Draws line series stacked.",
          "type": [
            "boolean",
            "string"
          ]
        },
        "title": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "unit": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "warn": {
          "description": "And Crit colour stat, gauge and bar values amber and red past them.",
          "type": [
            "number",
            "string"
          ]
        },
        "width": {
          "description": "Out of 24 columns, like Grafana (default 12, stat and gauge 6); Height in lines.",
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "type": "object"
    },
