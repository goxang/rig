    "Environment": {
      "additionalProperties": false,
      "properties": {
        "alerts": {
          "description": "Add to the project's alerts in this environment.",
          "items": {
            "$ref": "#/definitions/Alert"
          },
          "type": "array"
        },
        "components": {
          "additionalProperties": {
            "$ref": "#/definitions/Component"
          },
          "description": "components added or replaced here; one without type patches the shared one",
          "type": "object"
        },
        "description": {
          "description": "shown by rig env and the TUI",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "infra": {
          "description": "the environment that runs this one's shared services; they are started, stopped and reached there, and a Kubernetes runtime gets a Service pointing at the host for each",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "only": {
          "description": "services and groups that exist here; dependencies on the rest are dropped",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "otel": {
          "allOf": [
            {
              "$ref": "#/definitions/OTel"
            }
          ],
          "description": "fields replacing the project's otel: here (a local environment's endpoints, say)"
        },
        "protected": {
          "description": "changes need --yes or the TUI's confirmation",
          "type": [
            "boolean",
            "string"
          ]
        },
        "queries": {
          "additionalProperties": {
            "$ref": "#/definitions/Query"
          },
          "description": "saved queries replacing the project's of the same name",
          "type": "object"
        },
        "runtime": {
          "allOf": [
            {
              "$ref": "#/definitions/Component"
            }
          ],
          "description": "a component: type plus the runtime's options (below)"
        },
        "services": {
          "additionalProperties": {
            "$ref": "#/definitions/Service"
          },
          "description": "patches merged into services here: api: { replicas: 3 }",
          "type": "object"
        },
        "tasks": {
          "additionalProperties": {
            "$ref": "#/definitions/Task"
          },
          "description": "tasks replacing the project's tasks of the same name",
          "type": "object"
        },
        "vars": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "variables for this environment",
          "type": "object"
        }
      },
      "type": "object"
    },
    "LogsUI": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "description": "Fields, when set, are the only other keys shown, in this order; Hide are keys left out (stack, caller, ...) until h shows them.",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "hide": {
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "level": {
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "message": {
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "raw": {
          "description": "Shows lines as written instead of \"LEVEL message key=value\"; s switches.",
          "type": [
            "boolean",
            "string"
          ]
        },
        "time": {
          "description": "Time, Level and Message are the JSON keys of those parts, first match wins.",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "array"
        },
        "wrap": {
          "type": [
            "boolean",
            "string"
          ]
        }
      },
      "type": "object"
    },
    "OTel": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Added to every service's resource, after service.namespace (the project) and deployment.environment (the environment).",
          "type": "object"
        },
        "endpoint": {
          "description": "Takes every signal (an OpenTelemetry Collector: svc://otel-collector:4318); Traces, Metrics and Logs send one signal elsewhere, with its full path (svc://jaeger:4318/v1/traces). A signal with no address is off.",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "logs": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "metrics": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "protocol": {
          "description": "Http/protobuf (default), http/json or grpc.",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "sample": {
          "description": "The fraction of traces kept (parent based); left out, the SDK's default (all).",
          "type": [
            "number",
            "string"
          ]
        },
        "traces": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "type": "object"
    },
