        "help": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "multi": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "name": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
