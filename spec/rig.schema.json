              "type": [
                "boolean",
                "string"
              ]
            },
            "help": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "steps": {
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      ]
